{
  "name": "ground-unified-commerce-logistics",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:web": "npm run dev -w @ground/web",
    "dev:api": "npm run start:dev -w @ground/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:residuals": "node scripts/check-residuals.mjs"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
